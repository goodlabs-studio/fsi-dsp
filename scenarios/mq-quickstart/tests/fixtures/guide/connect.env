# ----------------------------------------------------------------------
# Environment variables for KAFCONN Started Task
# Based on Confluent Connect on z/OS Quickstart Guide
# ----------------------------------------------------------------------

# ----------------------------------------------------------------------
# JAVA ENVIRONMENT
# ----------------------------------------------------------------------
export JAVA_HOME=/usr/lpp/java/J11.0_64

# ----------------------------------------------------------------------
# KAFKA/CONFLUENT ENVIRONMENT
# ----------------------------------------------------------------------
export KAFKA_HOME=/u/kafconn/confluent/confluent-connect-7.5.2-zOS

# ----------------------------------------------------------------------
# IBM MQ INTEGRATION - CRITICAL FOR BINDINGS MODE
# As specified in Confluent z/OS quickstart guide
# ----------------------------------------------------------------------
export LIBPATH=$LIBPATH:/usr/lpp/mqm/V9R2M0/java/lib

# STEPLIB for MQ native libraries (alternative to JCL STEPLIB)
# Uncomment if not using JCL STEPLIB approach
# export STEPLIB=CSQ.SCSQAUTH:CSQ.SCSQANLE:$STEPLIB

# ----------------------------------------------------------------------
# MQ JAVA LIBRARIES IN CLASSPATH
# Required for MQ connector operation - do not prepend with $CLASSPATH
# to avoid duplicates as warned in the guide
# ----------------------------------------------------------------------
export CLASSPATH=/usr/lpp/mqm/V9R2M0/java/lib/com.ibm.mqjms.jar:/usr/lpp/mqm/V9R2M0/java/lib/com.ibm.mq.jmqi.jar:/usr/lpp/mqm/V9R2M0/java/lib/com.ibm.mq.allclient.jar

# ----------------------------------------------------------------------
# KAFKA CONNECT PLUGIN PATH
# Points to MQ Source and Sink connector directories
# ----------------------------------------------------------------------
export KAFKA_CONNECT_PLUGINS=/u/kafconn/connectors/mq-source,/u/kafconn/connectors/mq-sink

# ----------------------------------------------------------------------
# KAFKA_OPTS: CRITICAL FOR z/OS PERFORMANCE
# Set heap size appropriate for your workload
# Enable zIIP offloading for better performance
# ----------------------------------------------------------------------
export KAFKA_OPTS="-Xms4g -Xmx4g -Djava.awt.headless=true -XX:+UseG1GC -XX:+UseStringDeduplication"

# ----------------------------------------------------------------------
# LOGGING CONFIGURATION
# ----------------------------------------------------------------------
export LOG4J_CONFIGURATION_FILE=file:$KAFKA_HOME/etc/kafka/connect-log4j.properties

# ----------------------------------------------------------------------
# z/OS SPECIFIC SETTINGS FOR BETTER COMPATIBILITY
# ----------------------------------------------------------------------
export _BPXK_AUTOCVT=ON
export _CEE_RUNOPTS="ENVAR(JAVA_HOME=$JAVA_HOME)"
