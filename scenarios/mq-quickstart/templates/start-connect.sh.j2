#!{{ zos_bash_path }}
# =============================================================================
# start-connect.sh -- run by the {{ stc_name }} PROC (BPXBATCH PGM {{ zos_bash_path | basename }})
# =============================================================================
# Generated by fsi-dsp scenarios/mq-quickstart.
#
# Sets NO environment. Every variable comes from STDENV
# ({{ stdenv_path }}), so there is one place to look and nothing
# overwrites anything. This script checks STDENV actually arrived, then execs
# the worker so P {{ stc_name }} delivers SIGTERM straight to the JVM.
# Messages go to STDERR, which the PROC writes to {{ stderr_path }}.
# =============================================================================
set -euo pipefail

for var in JAVA_HOME LIBPATH KAFKA_HEAP_OPTS KAFKA_JVM_PERFORMANCE_OPTS KAFKA_LOG4J_OPTS LOG_DIR; do
  if [[ -z "${!var:-}" ]]; then
    echo "start-connect: ${var} is not set; check the STDENV DD in PROC {{ stc_name }}" >&2
    exit 2
  fi
done

worker_props="{{ connect_config_dir }}/connect-distributed.properties"
if [[ ! -r "${worker_props}" ]]; then
  echo "start-connect: cannot read ${worker_props}" >&2
  exit 2
fi

exec "{{ connect_home }}/bin/connect-distributed.sh" "${worker_props}"
