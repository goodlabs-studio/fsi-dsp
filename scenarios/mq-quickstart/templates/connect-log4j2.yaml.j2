# =============================================================================
# Kafka Connect on Z logging ({{ stc_name }}). Generated by fsi-dsp scenarios/mq-quickstart.
# =============================================================================
# Based on apache/kafka 4.1 config/connect-log4j2.yaml, with two z/OS changes:
#  1. charset IBM-1047 on the Console appender (Confluent Connect on z/OS),
#     so STDOUT, which the PROC writes to {{ stdout_path }}, is readable.
#  2. The Console appender gets WARN and above only. The PROC opens STDOUT
#     with OAPPEND and it never rotates, so it has to stay small. The full
#     INFO log goes to a size-capped rolling file in LOG_DIR.
# =============================================================================
Configuration:
  Properties:
    Property:
      - name: "kafka.logs.dir"
        value: "."
      - name: "logPattern"
        value: "[%d] %p %X{connector.context}%m (%c:%L)%n"

  Appenders:
    Console:
      name: STDOUT
      PatternLayout:
        pattern: "${logPattern}"
        charset: "IBM-1047"
      ThresholdFilter:
        level: WARN

    RollingFile:
      - name: ConnectAppender
        fileName: "${sys:kafka.logs.dir}/connect.log"
        filePattern: "${sys:kafka.logs.dir}/connect-%i.log"
        PatternLayout:
          pattern: "${logPattern}"
          charset: "IBM-1047"
        SizeBasedTriggeringPolicy:
          size: "100 MB"
        DefaultRolloverStrategy:
          max: 10

  Loggers:
    Root:
      level: INFO
      AppenderRef:
        - ref: STDOUT
        - ref: ConnectAppender
