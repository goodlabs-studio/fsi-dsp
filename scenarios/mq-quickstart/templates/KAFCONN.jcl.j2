//CONNECT  EXEC PGM=BPXBATCH,REGION=0M,TIME=NOLIMIT,
{{ 'PARM' | jcl_quoted('PGM ' ~ zos_bash_path ~ ' ' ~ start_script_path) }}
//*
//* IBM MQ BINDINGS NEEDS SCSQAUTH AND SCSQANLE (MQ FOR Z/OS JAVA
//* DOCS). THE STEPLIB DD REACHES THE JVM AS STEPLIB=CURRENT.
//STEPLIB  DD DISP=SHR,DSN={{ mq_hlq }}.SCSQAUTH
//         DD DISP=SHR,DSN={{ mq_hlq }}.SCSQANLE
//*
//* ENVIRONMENT: LITERAL NAME=VALUE RECORDS, ONE PER LINE.
{{ 'PATH' | jcl_quoted(stdenv_path, head='//STDENV   DD ', trailer=',') }}
//            PATHOPTS=ORDONLY
//*
//* OUTPUT TO Z/OS UNIX FILES, NOT THE JES SPOOL (CONFLUENT CONNECT ON
//* Z/OS: PREVENTS TRUNCATION ON A LONG-RUNNING TASK).
{{ 'PATH' | jcl_quoted(stdout_path, head='//STDOUT   DD ', trailer=',') }}
//            PATHOPTS=(OWRONLY,OCREAT,OAPPEND),
//            PATHMODE=(SIRWXU),FILEDATA=TEXT
